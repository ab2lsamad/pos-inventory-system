PORT=1234
DATABASE_URL="postgresql://postgres:postgres@localhost:1234/db_name?schema=public"

# Node environment: development | production
NODE_ENV=development

# JWT Configuration
# Generate strong, unique values for each secret (do NOT reuse the same value):
#   openssl rand -base64 48
# In production the app refuses to start if these are missing, too short, or
# left as placeholder/default values.
JWT_ACCESS_SECRET=your-access-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins (the frontend URLs).
# A wildcard cannot be used together with credentialed requests.
CORS_ORIGINS=http://localhost:3001
