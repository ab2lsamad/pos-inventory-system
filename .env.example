# Copy to .env and adjust. Consumed by docker-compose.yml.

# Postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=pos_system

# Backend JWT config — generate strong unique values: openssl rand -base64 48
JWT_ACCESS_SECRET=your-access-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed by the backend CORS policy
CORS_ORIGINS=http://localhost:3001

# Frontend -> backend URL (runs in the user's browser, so use the host address)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
